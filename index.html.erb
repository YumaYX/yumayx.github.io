---
layout: default
---

<section class="index-title">
  <div class="center">
    <h1><a href="/">THE DIGITAL COLLECTION #01</a></h1>
  </div>
</section>

<section class="index-works">
  <ul>
    <% cells = @content_data.to_a.sort + [[nil, nil]] %>

    <% cells.each do |name, info| %>
      <% if name %>
        <li>
          <a class="work-title" href="<%= info['url'] %>">
            <%= name %> - <%= info['short'] %>
          </a>
        </li>
      <% else %>
        <li>
          <a href="/docs/">more..</a>
        </li>
      <% end %>
    <% end %>
  </ul>
</section>