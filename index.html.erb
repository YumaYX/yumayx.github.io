---
layout: default
---

<section>
<div class="center">
<h1><a href="/">THE DIGITAL COLLECTION #01</a></h1>
</div>
</section>

<section>
<% cells = @content_data.to_a.sort + [[nil, nil]] %>
<% cells.each_slice(3) do |group| %>
<div class="row">
<% group.each do |name, info| %>
<% if name %>
<div class="one-third column">
<article>

<figure>
<a href="<%= info['url'] %>">
<img src="/assets/images/<%= name.downcase %>.png" class="u-max-full-width" style="border:0.7px solid #000;">
</a>
<figcaption>
    <a href="<%= info['url'] %>"><%= name %> - <%= info['short'] %></a>
    <p>PRICE — PRICELESS</p>
</figcaption></figure>

</article>
</div>
<% else %>
<div class="one-third column">
<article>

<figure>
<a href="/docs/">
<img src="/assets/images/others.png" class="u-max-full-width" style="border:0.7px solid #000;">
</a>
<figcaption>
    <a href="/docs/">more..</a>
</figcaption></figure>

</article>
</div>
<% end %>
<% end %>
</div>
<% end %>
</section>


<div class="row">
<div class="one-half column">
<hr>
